NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the project URL only — NOT https://your-project.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): set to https://masrofy-sigma.vercel.app
# Also add the same URL in Supabase → Authentication → URL Configuration:
# Site URL: https://masrofy-sigma.vercel.app
# Redirect URLs: https://masrofy-sigma.vercel.app/auth/callback and http://localhost:3000/auth/callback
# WhatsApp support number in international format without + (example: 201012345678)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (production error monitoring)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
