NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the project URL only — NOT https://your-project.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): set to https://masrofy-sigma.vercel.app
# Supabase project URL (NOT the Vercel site URL):
# NEXT_PUBLIC_SUPABASE_URL=https://ltqmfnpxjpguaqpwidkz.supabase.co
# Also add the same URL in Supabase → Authentication → URL Configuration:
# Site URL: https://masrofy-sigma.vercel.app
# Redirect URLs: https://masrofy-sigma.vercel.app/auth/callback and http://localhost:3000/auth/callback
# WhatsApp support number in international format without + (example: 201012345678)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (production error monitoring)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Web Push — due recurring notifications (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://masrofy-sigma.vercel.app
# Required in production for /api/cron/due-notifications (Vercel sends Bearer automatically when set)
CRON_SECRET=
ADMIN_EMAIL=muhammednasr10@gmail.com
# Optional: email category suggestions to the admin (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Masrofy <onboarding@resend.dev>

